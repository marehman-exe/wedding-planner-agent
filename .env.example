# Destination Wedding Planner — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Groq API key (free tier) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API key (free tier) — https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Not required ──────────────────────────────────────────────────────────────
# Kiwi Travel MCP (https://mcp.kiwi.com) is a free public server — no key needed.

# ── Optional — LangSmith tracing ─────────────────────────────────────────────
# Strongly recommended for multi-agent systems — lets you see the full
# nested call tree across coordinator and sub-agents.
# Sign up free at https://smith.langchain.com

# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=wedding-planner-agent
